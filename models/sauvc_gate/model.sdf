<?xml version="1.0" ?>
<!-- SAUVC qualification gate.

     Geometry (all numbers in metres):
       * top bar : white cylinder, length 1.50, diameter 0.04, lies along y
       * posts   : orange cylinders, length 1.00, diameter 0.04, vertical
                   at y = +/-0.75, hanging down from the water surface
       * the top of the bar sits at z = 0, i.e. the gate floats with its
         upper side on the water surface
       * the model is built around its own origin, so it is placed in a
         world with <pose>10 0 0 0 0 0</pose> for "10 m in front of the
         pool edge, parallel to it"

     Nominal opening is 1.50 m wide by 1.00 m high measured between the
     post centre lines and from the water surface. Because the tubes are
     4 cm thick, the clear opening is about 1.46 m x 0.96 m.

     Colours are the SAUVC reference colours, converted from sRGB hex to
     the linear values Gazebo expects:
       orange #FF910F -> (1.000, 0.283, 0.005)
       white  #FFFFFF -> (1.000, 1.000, 1.000)
     Keep the orange roughly at this hue: the vision pipeline keys on it.

     The gate is <static>true</static>: it is pinned at the surface and
     does not bob. Buoyancy/hydrodynamics only act on the ROV.
-->
<sdf version="1.6">
  <model name="sauvc_gate">
    <static>true</static>

    <!-- Left post: orange, from the surface down to z = -1.0 -->
    <link name="post_left">
      <pose>0 0.75 -0.5 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>1.0</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>1.0</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.000 0.283 0.005 1</ambient>
          <diffuse>1.000 0.283 0.005 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
          <!-- Slight self-illumination so the tube keeps its reference
               colour even on faces that get no direct sunlight. Without
               this the vertical posts render as dark brown. -->
          <emissive>0.850 0.241 0.004 1</emissive>
        </material>
      </visual>
    </link>

    <!-- Right post: orange, from the surface down to z = -1.0 -->
    <link name="post_right">
      <pose>0 -0.75 -0.5 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>1.0</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>1.0</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.000 0.283 0.005 1</ambient>
          <diffuse>1.000 0.283 0.005 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
          <!-- Slight self-illumination so the tube keeps its reference
               colour even on faces that get no direct sunlight. Without
               this the vertical posts render as dark brown. -->
          <emissive>0.850 0.241 0.004 1</emissive>
        </material>
      </visual>
    </link>

    <!-- Top bar: white, lies along y. A cylinder's axis is +z by default,
         so roll it 90 degrees about x. Centre z = -0.02 puts the upper
         side of the tube exactly on the water surface. -->
    <link name="bar_top">
      <pose>0 0 -0.02 1.5707963 0 0</pose>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>1.5</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>1.5</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
          <emissive>0.85 0.85 0.85 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
