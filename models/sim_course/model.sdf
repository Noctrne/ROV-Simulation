          <box>
            <size>0.20 0.20 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.30 0.30 0.32 1</ambient>
          <diffuse>0.35 0.35 0.37 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
    </link>

    <!-- ============================================================
         Slalom poles: three white poles 2 m apart. Their tips reach
         just above the ROV hover depth, so they must be steered around
         ============================================================ -->
    <link name="slalom">
      <pose>0.0 -3.0 -3.5 0 0 0</pose>

      <collision name="pole_1_collision">
        <pose>-2.0 0 0.8 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.055</radius>
            <length>1.6</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="pole_1_visual">
        <pose>-2.0 0 0.8 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.055</radius>
            <length>1.6</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.90 0.90 0.90 1</ambient>
          <diffuse>0.94 0.94 0.94 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
          <pbr>
