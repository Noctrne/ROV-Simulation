<?xml version="1.0" ?>
<!-- Static training course for the BlueROV2 simulation.

     Everything in this model is <static>true</static>, so the Buoyancy and
     Hydrodynamics plugins ignore it. Only the ROV is simulated dynamically.

     Reference frame:
       * ROV spawn point is (0, 0, -2)
       * seabed top surface is at z = -3.5 (1.5 m below the spawn point)
       * +x is forward, +y is left, +z is up

     Top view (looking down, ROV in the middle):

           +y
            |          blocks (0, 3)         buoy (2.5, 3.5)
            |      hurdle (-3.5, 1.5)        gate 2 (6, 2.5)
            |
            |   pipeline (-6.5, 0)            gate 1 (3.5, 0)
            + ::::::::::::::::::::::::::::::::::::::::::> +x
            |      rocks west (-5, -2)       rocks east (5.5, -1.5)
            |      slalom poles (x -2/0/2, y -3)
            |                               target board (5.5, -3.5)
-->
<sdf version="1.6">
  <model name="sim_course">
    <static>true</static>
    <self_collide>false</self_collide>
    <pose>0 0 0 0 0 0</pose>

    <!-- ============================================================
         Seabed plateau: a raised sand shelf whose top surface sits at
         z = -3.5 (1.5 m below the ROV spawn point). It is thick enough
         to reach down towards the original sea floor, so it reads as a
         plateau instead of a floating slab.
         ============================================================ -->
    <link name="seabed">
      <pose>0 0 -3.5 0 0 0</pose>

      <collision name="seabed_collision">
        <pose>0 0 -3.5 0 0 0</pose>
        <geometry>
          <box>
            <size>18 18 7.0</size>
          </box>
        </geometry>
      </collision>
      <visual name="seabed_visual">
        <pose>0 0 -3.5 0 0 0</pose>
        <geometry>
          <box>
            <size>18 18 7.0</size>
          </box>
        </geometry>
        <material>
          <ambient>0.72 0.66 0.52 1</ambient>
          <diffuse>0.76 0.69 0.54 1</diffuse>
          <specular>0.05 0.05 0.04 1</specular>
          <pbr>
            <metal>
              <roughness>0.95</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Sand mounds in the far corners, so they never block the
           flight path near the spawn point but still break up the floor -->
      <collision name="mound_1_collision">
        <pose>-4.0 4.5 -0.5 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.85</radius>
          </sphere>
        </geometry>
      </collision>
      <visual name="mound_1_visual">
        <pose>-4.0 4.5 -0.5 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.85</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.70 0.64 0.50 1</ambient>
          <diffuse>0.74 0.67 0.52 1</diffuse>
          <specular>0.05 0.05 0.04 1</specular>
        </material>
      </visual>
      <collision name="mound_2_collision">
        <pose>3.5 5.0 -0.55 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>1.10</radius>
          </sphere>
        </geometry>
      </collision>
      <visual name="mound_2_visual">
        <pose>3.5 5.0 -0.55 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>1.10</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.69 0.63 0.49 1</ambient>
          <diffuse>0.73 0.66 0.51 1</diffuse>
          <specular>0.05 0.05 0.04 1</specular>
        </material>
      </visual>
      <collision name="mound_3_collision">
        <pose>-6.0 -5.0 -0.55 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>1.00</radius>
          </sphere>
        </geometry>
      </collision>
      <visual name="mound_3_visual">
        <pose>-6.0 -5.0 -0.55 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>1.00</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.71 0.65 0.51 1</ambient>
          <diffuse>0.75 0.68 0.53 1</diffuse>
          <specular>0.05 0.05 0.04 1</specular>
        </material>
      </visual>
    </link>

    <!-- ============================================================
         Gate 1 (yellow PVC pipe frame).
         Opening 1.30 m wide x 1.85 m high, faces +/-x so the ROV
         passes through it by flying forward.
         ============================================================ -->
    <link name="gate_1">
      <pose>3.5 0.0 -3.5 0 0 0</pose>

      <collision name="g1_leg_l_collision">
        <pose>0 0.65 0.95 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>1.9</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="g1_leg_l_visual">
        <pose>0 0.65 0.95 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>1.9</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.90 0.75 0.10 1</ambient>
          <diffuse>0.95 0.80 0.12 1</diffuse>
          <specular>0.35 0.32 0.20 1</specular>
          <pbr>
            <metal>
              <roughness>0.45</roughness>
              <metalness>0.05</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="g1_leg_r_collision">
        <pose>0 -0.65 0.95 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>1.9</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="g1_leg_r_visual">
        <pose>0 -0.65 0.95 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>1.9</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.90 0.75 0.10 1</ambient>
          <diffuse>0.95 0.80 0.12 1</diffuse>
          <specular>0.35 0.32 0.20 1</specular>
          <pbr>
            <metal>
              <roughness>0.45</roughness>
              <metalness>0.05</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="g1_top_collision">
        <pose>0 0 1.9 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>1.39</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="g1_top_visual">
        <pose>0 0 1.9 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>1.39</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.90 0.75 0.10 1</ambient>
          <diffuse>0.95 0.80 0.12 1</diffuse>
          <specular>0.35 0.32 0.20 1</specular>
          <pbr>
            <metal>
              <roughness>0.45</roughness>
              <metalness>0.05</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Foot plates that keep the frame standing on the sand -->
      <collision name="g1_foot_l_collision">
        <pose>0 0.65 0.015 0 0 0</pose>
        <geometry>
          <box>
            <size>0.20 0.20 0.03</size>
          </box>
        </geometry>
      </collision>
      <visual name="g1_foot_l_visual">
        <pose>0 0.65 0.015 0 0 0</pose>
        <geometry>
          <box>
            <size>0.20 0.20 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.30 0.30 0.32 1</ambient>
          <diffuse>0.35 0.35 0.37 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
      <collision name="g1_foot_r_collision">
        <pose>0 -0.65 0.015 0 0 0</pose>
        <geometry>
          <box>
            <size>0.20 0.20 0.03</size>
          </box>
        </geometry>
      </collision>
      <visual name="g1_foot_r_visual">
        <pose>0 -0.65 0.015 0 0 0</pose>
        <geometry>
          <box>
            <size>0.20 0.20 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.30 0.30 0.32 1</ambient>
          <diffuse>0.35 0.35 0.37 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
    </link>

    <!-- ============================================================
