            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <!-- ============================================================
         Pipe hurdle: horizontal bar 1.5 m above the sand, i.e. right
         at the ROV's hover depth. Forces a climb-over or a dive-under
         ============================================================ -->
