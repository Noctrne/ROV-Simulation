<?xml version="1.0" ?>
<!-- SAUVC qualification arena - the existing worlds are untouched.

     Course, per the SAUVC qualification rules used here:
       * start at the pool edge (x = 0), facing +x
       * gate 10 m ahead, parallel to the pool edge, floating with its
         upper side on the water surface
       * bottom: 1.28 m deep for the first 1.8 m, then a slope down to
         2.00 m over 17.5 m, then 1 m flat

     Water surface is z = 0, so the gate opening spans z = 0 .. -1.0 and
     its lower edge is about 0.6 m above the bottom at x = 10.

     Run it with the normal launcher:
       ./scripts/start_sim.sh sauvc_qualification.world
       ./scripts/start_sim.sh sauvc_qualification.world  (add the FPV flag
       described in RUNBOOK_SIMULASI.md section 1.6 to get the camera panel)
-->
<sdf version="1.6">
  <world name="sauvc_qualification">

    <!-- Base Gazebo plugins -->
    <plugin
        filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics">
    </plugin>
    <plugin
        filename="gz-sim-user-commands-system"
        name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
        filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- IMU plugin manages all IMU sensors -->
    <plugin filename="libgz-sim-imu-system.so"
            name="gz::sim::systems::Imu">
    </plugin>

    <!-- Sensors plugin renders camera sensors. Required by the FPV camera
         on bluerov2_heavy; without it the camera produces no images. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Buoyancy plugin manages buoyancy for all models -->
    <plugin
        filename="gz-sim-buoyancy-system"
        name="gz::sim::systems::Buoyancy">
      <!-- Fluid density is 1 (air) above 0 and 1000 (water) below 0 -->
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <!-- Enable by model name -->
      <enable>bluerov2_heavy</enable>
    </plugin>

    <scene>
      <ambient>0.45 0.50 0.55</ambient>
      <background>0.55 0.70 0.80</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
      <pose>0 0 10 0 0 0</pose>
    </include>

    <!-- Pool: floor profile + walls. Water surface is z = 0. -->
    <include>
      <uri>model://sauvc_pool</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Gate: 10 m from the pool edge, parallel to it. -->
    <include>
      <uri>model://sauvc_gate</uri>
      <pose>10 0 0 0 0 0</pose>
    </include>

    <!-- ROV starts just inside the pool edge, 0.6 m below the surface. -->
    <include>
      <uri>model://bluerov2_heavy</uri>
      <pose>0.4 0 -0.6 0 0 0</pose>
    </include>

  </world>
</sdf>
